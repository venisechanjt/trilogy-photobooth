{
  "name": "photobooth",
  "version": "1.0.0",
  "description": "Self-service photobooth kiosk: 3 cuts, 4 cuts and 4R layouts with printing and email delivery",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --dry",
    "setup-email": "node scripts/setup-email.js",
    "set-pin": "node scripts/set-pin.js",
    "printer-sizes": "node scripts/printer-sizes.js",
    "print-check": "node scripts/print-check.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.15.2"
  },
  "optionalDependencies": {
    "pdf-to-printer": "^5.6.0"
  }
}
