# Copy this file to .env and fill it in.

PORT=3000

# --- Printing ---
# system = send to the laptop's printer, dry = only save PDFs to /output (testing)
PRINT_MODE=system
# Leave empty to use the system default printer (can also be picked in the ⚙️ settings)
PRINTER_NAME=
# macOS/Linux only: CUPS paper size name. w288h432 = 4x6in. Some printers use "4x6" or "Postcard.Fullbleed"
PRINT_MEDIA=w288h432
MAX_COPIES=10
OUTPUT_DIR=./output

# --- Settings PIN ---
# Locks the ⚙️ settings. Set it with: npm run set-pin (leave empty for no PIN)
ADMIN_PIN=

# --- Email (digital copies) ---
# Gmail example: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Photobooth <your.address@gmail.com>"
